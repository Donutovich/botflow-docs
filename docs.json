{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BotFlow",
  "description": "BotFlow, CRM-платформа для управления Telegram-ботами: конструктор воронок, переписки, рассылки, ИИ-оператор, трекер.",
  "colors": {
    "primary": "#0A0A0B",
    "light": "#E5E5E6",
    "dark": "#0A0A0B"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
